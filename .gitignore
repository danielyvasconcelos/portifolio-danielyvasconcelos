# ==========================================================================
# .gitignore - Arquivos e pastas ignorados pelo Git
# ==========================================================================

# Arquivos do sistema operacional
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Linux
*~
.nfs*

# Editores e IDEs
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependências (caso adicione Node.js futuramente)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Arquivos de build e distribuição
dist/
build/
out/
.cache/

# Arquivos temporários
*.tmp
*.temp
.tmp/
.temp/

# Arquivos de backup
*.bak
*.backup
*~

# Arquivos de configuração local
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Arquivos de cache
.cache/
*.cache

# Arquivos de teste
coverage/
.nyc_output/

# Arquivos específicos do projeto
# (adicione aqui arquivos específicos que não devem ser versionados)

# Imagens temporárias ou de teste
# assets/images/temp/
# assets/images/test/